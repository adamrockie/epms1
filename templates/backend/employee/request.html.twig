{% extends "backend/patials/master.html" %}


{% block title %} {{title}} {% endblock %}

{% block headscripts %}

<link rel="stylesheet" href="assets/css/bootstrap-datetimepicker.min.css">
<!-- Datatable CSS -->
<link rel="stylesheet" href="assets/css/dataTables.bootstrap4.min.css">

<style>
    /* Preview */
    .preview {
        width: 100px;
        height: 100px;
        border: 1px solid black;
        margin: 0 auto;
        background: white;
    }

    .preview img {
        display: none;
    }
</style>

{% endblock %}

{% block content %}

<div id="fakeloader-overlay" class="visible incoming">
    <div class="loader-wrapper-outer">
        <div class="loader-wrapper-inner">
            <div class="loader"></div>
        </div>
    </div>
</div>

<!-- Page Content -->
<div class="content container-fluid" id="mcontents">



    <div class="row">
        <div class="col-md-12">
            <div class="table-responsive">
                <table class="table table-striped custom-table datatable" id="staff_table">
                    <thead>
                        <tr>
                            <th>Item Name</th>
                            <th>Qty</th>
                            <th>Status</th>
                            <th>Requested By</th>
                            <th>Date</th>
                            <th class="text-end no-sort">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for item in all_item_requests %}
                        <tr>
                            <td>{{ item.item_name }}</td>
                            <td>{{ item.qty }}</td>
                            <td>

                                <span
                                    class="badge bg-{{ item.status == 'approve' ? 'success' : (item.status == 'pending' ? 'warning' : (item.status == 'reject' ? 'danger' : (item.status == 'not_disbursed' ? 'danger' : (item.status == 'disbursed' ? 'info' : 'secondary')))) }}">
                                    {{ item.status|replace({'_': ' '})|title }}
                                </span>
                            </td>

                            <td>
                                {{ item.staff.surname ?? '' }}
                                {{ item.staff.middlename ?? '' }}
                                {{ item.staff.lastname ?? '' }}
                            </td>
                            <td>{{ item.request_date }}</td>

                            <td class="text-end d-flex justify-content-end">
                                <a href="javascript:void(0)"
                                    onclick="viewQR('{{item.id}}', '{{item.item_name|e('js')}}', '{{item.serial_no|e('js')}}')">
                                    <i class="fa fa-qrcode m-r-5"></i>
                                </a>
                                <div class="dropdown dropdown-action">
                                    <a href="#" class="action-icon dropdown-toggle" data-bs-toggle="dropdown"
                                        aria-expanded="false"><i class="material-icons">more_vert</i></a>
                                    <div class="dropdown-menu dropdown-menu-right">
                                        <a class="dropdown-item" href="#" data-bs-toggle="modal"
                                            data-bs-target="#view_comment_modal"
                                            onclick="view_comment(`{{ item.comment | escape }}`)">
                                            <i class="fa fa-eye m-r-5"></i> Note
                                        </a>

                                        {% if item.status == 'reject' %}
                                        <a class="dropdown-item" href="#" data-bs-toggle="modal"
                                            data-bs-target="#view_rejection_modal"
                                            onclick="view_rejection_reason(`{{ item.head_rejection_reason ?? '' }}`, `{{ item.agf_rejection_reason ?? '' }}`)">
                                            <i class="fa fa-ban m-r-5"></i> View Rejection Reason
                                        </a>
                                        {% else %}
                                        <a class="dropdown-item" href="#" data-bs-toggle="modal"
                                            data-bs-target="#edit_inventory"
                                            onclick="edit_request({{ item.id }}, {{ item.qty }}, '{{ item.item_name|escape }}', '{{ item.item_id }}', '{{ item.ippis }}', '{{ item.serial_no }}')"><i
                                                class="fa fa-pencil m-r-5"></i> Edit</a>
                                        {% endif %}

                                    </div>
                                </div>
                            </td>
                        </tr>

                        {% endfor %}
                    </tbody>
                </table>

                <!-- View Rejection Reason Modal -->
                <div id="view_rejection_modal" class="modal custom-modal fade" role="dialog">
                    <div class="modal-dialog modal-dialog-centered" role="document">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h5 class="modal-title">Rejection Reason</h5>
                                <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                                    <span aria-hidden="true">&times;</span>
                                </button>
                            </div>
                            <div class="modal-body">
                                <div id="rejection_reason_body">
                                    <p class="text-muted">No reason provided.</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- View Item Image Modal -->

                <div id="view_inventory_modal" class="modal"
                    style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.6); justify-content:center; align-items:center;">
                    <div
                        style="background:#fff; padding:20px; border-radius:8px; max-width:500px; width:90%; position:relative;">
                        <button id="close_inventory_modal"
                            style="position:absolute; top:10px; right:10px; border:none; background:none; font-size:18px; cursor:pointer;">&times;</button>
                        <img id="inventory_modal_image" src="" alt="Inventory"
                            style="width:100%; height:auto; display:block; margin-top:20px;">
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>
<!-- /Page Content -->

<!-- Edit Request Status Modal -->
<div id="edit_inventory" class="modal custom-modal fade" role="dialog">
    <div class="modal-dialog modal-dialog-centered modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Update Request Status</h5>
                <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>

            <div class="modal-body">
                <form id="form_edit_request" method="post">

                    <!-- Hidden Fields -->
                    <input type="hidden" name="id" id="eid">
                    <input type="hidden" name="item_id" id="eitem_id">
                    <input type="hidden" name="ippis" id="eeippis">
                    <input type="hidden" value="{{token}}" name="token">

                    <div class="row">

                        <!-- Requested Quantity (Read-only) -->
                        <div class="col-sm-12">
                            <div class="form-group">
                                <label class="col-form-label">Request</label>
                                <input class="form-control" type="text" id="request_display" readonly>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="form-group">
                                <div class="col-sm-12">
                                    <div class="form-group">
                                        <label class="col-form-label">Serial No.</label>
                                        <input class="form-control" type="text" id="request_serial" readonly>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Given Status -->
                        <div class="col-sm-6">
                            <div class="form-group">
                                <label class="col-form-label">Status</label>
                                <select class="form-select" name="status" id="status">
                                    <option value="">Select...</option>
                                    <option value="disbursed">Disbursed</option>
                                    <option value="not_disbursed">Not Disbursed</option>
                                </select>
                            </div>
                        </div>



                        <!-- Comment -->
                        <div class="col-sm-12">
                            <div class="form-group">
                                <label class="col-form-label">Justify the decision taken</label>
                                <textarea class="form-control" name="comment" id="comment" rows="4"
                                    placeholder="Please justify the decision taken..."></textarea>
                            </div>
                        </div>

                    </div>


                    <!-- Submit -->
                    <div class="submit-section">
                        <button type="submit" class="btn btn-primary submit-btn">
                            Update Request
                        </button>
                    </div>

                </form>
            </div>
        </div>
    </div>
</div>
<!-- /Edit Request Modal -->


<!-- Qr code Modal -->
<div id="qr_modal" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%;
     background:rgba(0,0,0,0.6); justify-content:center; align-items:center;">

    <div
        style="background:#fff; padding:20px; border-radius:8px; max-width:400px; width:90%; text-align:center; position:relative;">

        <button onclick="closeQRModal()"
            style="position:absolute; top:10px; right:10px; border:none; background:none; font-size:18px; cursor:pointer;">
            &times;
        </button>

        <h5>QR Code</h5>

        <img id="qr_image" src="" style="width:200px; margin:20px 0;">

        <br>

        <button onclick="printQR()" class="btn btn-primary btn-sm">
            Print QR
        </button>

    </div>
</div>

<!-- /Qr code Modal -->


<!-- Comment Modal -->
<div id="view_comment_modal" class="modal custom-modal fade" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-dialog-centered modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Issuing Note</h5>
                <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <p id="comment_text"
                    style="white-space: pre-wrap; background:#f8f9fa; padding:10px; border-radius:5px;"></p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>


{% endblock %}

{% block jsscript %}

<!-- Datetimepicker JS -->
<script src="assets/js/moment.min.js"></script>
<script src="assets/js/bootstrap-datetimepicker.min.js"></script>
<!-- Datatable JS -->
<script src="assets/js/jquery.dataTables.min.js"></script>
<script src="assets/js/dataTables.bootstrap4.min.js"></script>
<!-- Select 2 -->
<script src="assets/backend/js/select2.full.min.js"></script>

<script>

    view_profile = function (id) {
        //alert(id);
        window.location.href = "profile/" + id;
    }

    $(document).ready(
        function () {
            window.FakeLoader.init({ auto_hide: true });
        }
    );

    function view_comment(comment) {
        document.getElementById('comment_text').textContent = comment || 'No comment available.';
    }

</script>
<script>
    // Show modal function
    function viewInventoryImage(uploadFileName) {
        var modal = document.getElementById('view_inventory_modal');
        var img = document.getElementById('inventory_modal_image');

        img.src = 'uploads/inventory/' + uploadFileName; // set the image
        modal.style.display = 'flex'; // show modal
    }

    // Close modal
    document.getElementById('close_inventory_modal').addEventListener('click', function () {
        document.getElementById('view_inventory_modal').style.display = 'none';
    });

    // close modal when clicking outside the modal content
    document.getElementById('view_inventory_modal').addEventListener('click', function (e) {
        if (e.target === this) {
            this.style.display = 'none';
        }
    });

    $(document).ready(function () {
        $('#repinventory').select2({
            dropdownParent: $('#report'),
            placeholder: "Select Inventory",
            allowClear: true
        });
    });

</script>
<script>
    window.view_rejection_reason = function (headReason, agfReason) {
        let html = '';

        if (headReason && headReason.trim() !== '') {
            html += '<p><strong>Director:</strong> ' + $('<div>').text(headReason).html() + '</p>';
        }

        if (agfReason && agfReason.trim() !== '') {
            html += '<p><strong>AGF:</strong> ' + $('<div>').text(agfReason).html() + '</p>';
        }

        if (html === '') {
            html = '<p class="text-muted">No reason provided.</p>';
        }

        $('#rejection_reason_body').html(html);
    };
    function viewQR(id, name, serial) {
        const modal = document.getElementById("qr_modal");
        const img = document.getElementById("qr_image");

        img.src = "/epms1/functions/generate_qr.php?id=" + id;
        img.dataset.itemName = name || "";
        img.dataset.itemSerial = serial || "";

        modal.style.display = "flex";
    }

    function closeQRModal() {
        document.getElementById("qr_modal").style.display = "none";
    }

    function printQR() {
        const img = document.getElementById("qr_image");
        const itemName = img.dataset.itemName || "Unnamed Item";
        const itemSerial = img.dataset.itemSerial || "N/A";

        fetch(img.src, { credentials: "omit" })
            .then(res => res.blob())
            .then(blob => {
                const objectURL = URL.createObjectURL(blob);

                const win = window.open('', '', 'width=600,height=250');
                win.document.write(`
             <html>
            <head>
                <title>Print QR</title>
                <style>
                    @page {
                        size: 90.3mm 29mm;
                        margin: 0;
                    }
                    * {
                        margin: 0;
                        padding: 0;
                        box-sizing: border-box;
                        -webkit-print-color-adjust: exact;
                        print-color-adjust: exact;
                        color-adjust: exact;
                    }
                    body {
                        width: 90.3mm;
                        height: 29mm;
                        background: #fff;
                        font-family: Arial, Helvetica, sans-serif;
                        display: flex;
                        flex-direction: row;
                        align-items: stretch;
                        overflow: hidden;
                    }

                    /* ── Left: Black brand strip ── */
                    .brand-strip {
                        width: 6mm;
                        background: #000 !important;
                        display: flex;
                        align-items: center;
                        justify-content: center;
                        flex-shrink: 0;
                    }
                    .brand-strip span {
                        color: #fff !important;
                        font-size: 5.5pt;
                        font-weight: bold;
                        letter-spacing: 2.5px;
                        writing-mode: vertical-rl;
                        transform: rotate(180deg);
                        white-space: nowrap;
                    }

                    /* ── QR Code section ── */
                    .qr-section {
                        width: 27mm;
                        display: flex;
                        align-items: center;
                        justify-content: center;
                        padding: 1mm;
                        flex-shrink: 0;
                    }
                    .qr-wrap {
                        border: 0.4mm solid #000;
                        padding: 0.7mm;
                        display: flex;
                        align-items: center;
                        justify-content: center;
                        background: #fff !important;
                    }
                    .qr-wrap img {
                        width: 21mm;
                        height: 21mm;
                        display: block;
                    }

                    /* ── Text section ── */
                    .text-section {
                        flex: 1;
                        min-width: 0;
                        display: flex;
                        flex-direction: column;
                        justify-content: center;
                        padding: 2mm 2.8mm;
                        gap: 1.3mm;
                        overflow: hidden;
                    }
                    .item-name {
                        font-size: 7.5pt;
                        font-weight: bold;
                        color: #111;
                        white-space: nowrap;
                        overflow: hidden;
                        text-overflow: ellipsis;
                        max-width: 100%;
                    }

                    /* ── Serial number curved card ── */
                    .serial-card {
                        display: inline-flex;
                        align-items: center;
                        gap: 1mm;
                        background: #111 !important;
                        border-radius: 3mm 1mm 3mm 1mm;
                        padding: 1mm 2.2mm;
                        max-width: fit-content;
                    }
                    .serial-label {
                        font-size: 4pt;
                        color: #fff !important;
                        letter-spacing: 0.6px;
                       
                        font-weight: bold;
                    }
                    .serial-value {
                        font-size: 6.5pt;
                        color: #fff !important;
                        font-weight: bold;
                        letter-spacing: 0.4px;
                        white-space: nowrap;
                        overflow: hidden;
                        text-overflow: ellipsis;
                    }

                    .site-url {
                        font-size: 6pt;
                        color: #000;
                        letter-spacing: 0.3px;
                        font-weight: 600;
                        margin-top: 10px;
                        text-align: center;
                    }
                    .footer-text {
                        font-size: 6pt;
                        color: #000;
                        font-weight: 600;
                        letter-spacing: 1.2px;
                        text-transform: uppercase;
                    
                    }
                </style>
            </head>
            <body>

                <div class="brand-strip">
                    <span>OAUGF</span>
                </div>

                <div class="qr-section">
                    <div class="qr-wrap">
                        <img src="${objectURL}" onload="window.print(); window.close();" />
                    </div>
                </div>

                <div class="text-section">
                <div class="footer-text">— OAUGF AMS —</div>
                    <div class="item-name">${itemName}</div>
                    <div class="serial-card">
                        <span class="serial-label">Serial number:</span>
                        <span class="serial-value">${itemSerial}</span>
                    </div>
                    <div class="site-url">www.oaugf.ng</div>
                    
                </div>

            </body>
            </html>
        `);
                win.document.close();
            })
            .catch(err => {
                console.error("Failed to load QR image for printing:", err);
                alert("Could not load QR code for printing. Please try again.");
            });
    }
</script>

<script src="templates/backend/employee/request.js"></script>




{% endblock %}