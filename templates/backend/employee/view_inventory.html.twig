{% extends "backend/patials/master.html" %} {% block title %} View Inventory {%
endblock %} {% block content %}

<div class="content container-fluid">
  <!-- HEADER CARD -->
  <div class="card shadow-sm border-0 mb-3">
    <div class="card-body d-flex justify-content-between align-items-center">
      <div>
        <h4 class="mb-0">{{ item.inventory }}</h4>
        <small class="text-muted">Inventory Details</small>
      </div>

      <!--button class="btn btn-success btn-sm" onclick="useItem({{ item.id }})">
        Confirm
      </button-->
    </div>
  </div>

  <!-- DETAILS CARD -->
  <div class="card shadow-sm border-0 mb-3">
    <div class="card-body">
      <div class="row">
        <div class="col-md-6">
          <p><strong>Serial No.:</strong> {{ item.serial_no }}</p>
          <p><strong>Amount:</strong> ₦{{ item.amount }}</p>
          <p><strong>Warranty:</strong> {{ item.warranty }}</p>
        </div>

        <div class="col-md-6">
          <p><strong>Life Span:</strong> {{ item.life_span }} year(s)</p>
          <p><strong>Status:</strong> {{ item.status }}</p>
          <p><strong>Date:</strong> {{ item.date }}</p>
        </div>
      </div>
    </div>
  </div>

  <!-- IMAGE CARD ONLY -->
  <div class="card shadow-sm border-0 mb-3">
    <div class="card-body text-center">
      <h6 class="mb-3">Item Image</h6>

      <img src="/epms1/uploads/inventory/{{ item.upload }}" style="
          width: 220px;
          height: 220px;
          object-fit: cover;
          border-radius: 10px;
        " />
    </div>
  </div>
</div>

{% endblock %}

{% block jsscript %}
<script src="templates/backend/employee/view_inventory.js"></script>

{% endblock %}