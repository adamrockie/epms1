{% extends "backend/patials/master.html" %}


{% block title %} {{title}} {% endblock %}

{% block headscripts %}

<link rel="stylesheet" href="assets/css/bootstrap-datetimepicker.min.css">
<!-- Datatable CSS -->
<link rel="stylesheet" href="assets/css/dataTables.bootstrap4.min.css">

<style>
    .badge-status {
        font-size: 12px;
        padding: 5px 10px;
    }
</style>

{% endblock %}

{% block content %}

<div id="fakeloader-overlay" class="visible incoming">
    <div class="loader-wrapper-outer">
        <div class="loader-wrapper-inner">
            <div class="loader"></div>
        </div>
    </div>
</div>

<!-- Page Content -->
<div class="content container-fluid" id="mcontents">

    <!-- Page Header -->
    <div class="page-header">
        <div class="row align-items-center">
            <div class="col">
                <h3 class="page-title">Procurement Request</h3>
                <ul class="breadcrumb">
                    <li class="breadcrumb-item"><a href="dashboard">Dashboard</a></li>
                    <li class="breadcrumb-item active">Procurement Request</li>
                </ul>
            </div>
        </div>
        <div class="content container-fluid">
            <div class="row">
                <div class="col-md-6 col-sm-6 col-lg-6 col-xl-3">
                    <div class="card dash-widget">
                        <div class="card-body">
                            <span class="dash-widget-icon"><i class="fa fa-list-alt"></i></span>
                            <div class="dash-widget-info">
                                <h3>{{total_requests}}</h3>
                                <span>My <br>Requests</span>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-6 col-sm-6 col-lg-6 col-xl-3">
                    <div class="card dash-widget">
                        <div class="card-body">
                            <span class="dash-widget-icon"><i class="fa fa-clock-o"></i></span>
                            <div class="dash-widget-info">
                                <h3>{{total_pending}}</h3>
                                <span>Pending</span>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-6 col-sm-6 col-lg-6 col-xl-3">
                    <div class="card dash-widget">
                        <div class="card-body">
                            <span class="dash-widget-icon"><i class="fa fa-check-circle"></i></span>
                            <div class="dash-widget-info">
                                <h3>{{total_approved}}</h3>
                                <span>Approved</span>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-6 col-sm-6 col-lg-6 col-xl-3">
                    <div class="card dash-widget">
                        <div class="card-body">
                            <span class="dash-widget-icon"><i class="fa fa-times-circle"></i></span>
                            <div class="dash-widget-info">
                                <h3>{{total_rejected}}</h3>
                                <span>Rejected</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- /Page Header -->

        <div class="row">
            <div class="col-md-12">
                <div class="col-auto float-end ms-auto mb-3">
                    <a href="#" class="btn add-btn" data-bs-toggle="modal" data-bs-target="#add_request"><i
                            class="fa fa-plus"></i> New Request</a>
                </div>
                <div class="table-responsive">
                    <table class="table table-striped custom-table datatable" id="request_table">
                        <thead>
                            <tr>
                                <th>Subject</th>
                                <th>Description</th>
                                <th>Date Requested</th>
                                <th>Status</th>
                                <th class="text-end no-sort">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for req in my_requests %}
                            <tr>
                                <td>{{ req.subject }}</td>

                                {# Description: show only first 5 words + eye icon #}
                                <td>
                                    {% set words = req.description|split(' ') %}
                                    {{ words|slice(0, 5)|join(' ') }}{% if words|length > 5 %}...{% endif %}

                                    <a href="javascript:void(0);" class="text-primary ms-2 view-desc-btn"
                                        data-description="{{ req.description|e('html_attr') }}"
                                        title="View full description">
                                        <i class="fa fa-eye"></i>
                                    </a>
                                </td>

                                <td>{{ req.created_at }}</td>

                                <td>
                                    {% if req.status == 'approve' %}
                                    <span class="badge bg-success badge-status">Approved</span>
                                    {% elseif req.status == 'reject' %}
                                    <span class="badge bg-danger badge-status">Rejected</span>
                                    {% elseif req.status == 'disbursed' %}
                                    <span class="badge bg-info badge-status">Disbursed</span>
                                    {% else %}
                                    <span class="badge bg-warning badge-status">Pending</span>
                                    {% endif %}
                                </td>

                                <td class="text-end">
                                    {% if req.status == 'pending' %}
                                    <div class="btn-group btn-group-sm">
                                        <a href="edit-request/{{ req.id }}" class="btn btn-outline-primary"
                                            title="Edit">
                                            <i class="fa fa-edit"></i>
                                        </a>

                                        <button type="button" class="btn btn-outline-danger delete-request-btn"
                                            data-id="{{ req.id }}" data-subject="{{ req.subject|e('html_attr') }}"
                                            title="Delete">
                                            <i class="fa fa-trash"></i>
                                        </button>

                                        <button type="button" class="btn btn-outline-secondary add-remark-btn"
                                            data-id="{{ req.id }}" data-subject="{{ req.subject|e('html_attr') }}"
                                            title="Add Remark">
                                            <i class="fa fa-comment"></i>
                                        </button>
                                    </div>
                                    {% else %}
                                    <button class="btn btn-sm btn-primary view-note-btn"
                                        data-subject="{{ req.subject|e('html_attr') }}"
                                        data-status="{{ req.status|e('html_attr') }}"
                                        data-note="{{ req.note|e('html_attr') }}">
                                        View Note
                                    </button>
                                    {% endif %}
                                </td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
    <!-- /Page Content -->

    <!-- Add Request Modal -->
    <div id="add_request" class="modal custom-modal fade" role="dialog">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">New Procurement Request</h5>
                    <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <form id="form_request_item" method="post" enctype="multipart/form-data">
                        <div class="row">
                            <div class="col-sm-12">
                                <div class="form-group">
                                    <label class="col-form-label">Subject <span class="text-danger">*</span></label>
                                    <input class="form-control" type="text" name="subject" id="subject"
                                        placeholder="e.g. Request for office chairs" required>
                                </div>
                            </div>

                            <div class="col-sm-12">
                                <div class="form-group-text">
                                    <label class="col-form-label">Description <span class="text-danger">*</span></label>
                                    <textarea class="form-control" name="description" id="description" rows="5"
                                        placeholder="Describe what you need, how many, and why..." required></textarea>
                                </div>
                            </div>
                        </div>

                        <input type="hidden" value="{{token}}" name="token">

                        <div class="submit-section">
                            <button type="submit" class="btn btn-primary submit-btn">Submit Request</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
    <!-- /Add Request Modal -->

    <!-- View Note Modal -->
    <div id="view_note" class="modal custom-modal fade" role="dialog">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Request Note</h5>
                    <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <p><strong>Subject:</strong> <span id="note_subject"></span></p>
                    <p><strong>Status:</strong> <span id="note_status"></span></p>
                    <p><strong>Note from Reviewer:</strong></p>
                    <p id="note_text" class="text-muted"></p>
                </div>
            </div>
        </div>
    </div>
    <!-- /View Note Modal -->

    <!-- View Description Modal -->
    <div id="view_description" class="modal custom-modal fade" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Full Description</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p id="full_description_text" class="mb-0"></p>
                </div>
            </div>
        </div>
    </div>

    <!-- Add Remark Modal -->
    <div id="add_remark" class="modal custom-modal fade" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Add Remark</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <form id="remark_form" method="post" action="add-request-remark">
                    <div class="modal-body">
                        <input type="hidden" name="request_id" id="remark_request_id">

                        <div class="mb-3">
                            <label class="form-label">Request</label>
                            <input type="text" class="form-control" id="remark_subject" readonly>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Remark</label>
                            <textarea class="form-control" name="remark" id="remark_text" rows="4"
                                placeholder="Enter your remark..." required></textarea>
                        </div>

                        <input type="hidden" name="token" value="{{ token }}">
                    </div>

                    <div class="modal-footer">
                        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary">Save Remark</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Delete Confirmation Modal -->
    <div id="delete_request_modal" class="modal custom-modal fade" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title text-danger">Delete Request</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body text-center">
                    <i class="fa fa-exclamation-triangle text-danger mb-3" style="font-size:40px;"></i>
                    <p>Are you sure you want to delete this request?</p>
                    <p class="fw-bold" id="delete_request_subject"></p>
                </div>

                <div class="modal-footer justify-content-center">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>

                    <form id="delete_request_form" method="post" action="delete-request" class="d-inline">
                        <input type="hidden" name="request_id" id="delete_request_id">
                        <input type="hidden" name="token" value="{{ token }}">

                        <button type="submit" class="btn btn-danger">
                            <i class="fa fa-trash me-1"></i> Delete
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>


</div>

{% endblock %}

{% block jsscript %}

<script src="assets/js/moment.min.js"></script>
<script src="assets/js/bootstrap-datetimepicker.min.js"></script>
<!-- Datatable JS -->
<script src="assets/js/jquery.dataTables.min.js"></script>
<script src="assets/js/dataTables.bootstrap4.min.js"></script>
<!-- Select 2 -->
<script src="assets/backend/js/select2.full.min.js"></script>

<script>
    $(document).ready(function () {
        window.FakeLoader.init({ auto_hide: true });
    });
</script>
<script>
    $(function () {

        // View full description
        $(document).on('click', '.view-desc-btn', function () {
            const description = $(this).data('description') || '';
            $('#full_description_text').text(description);
            $('#view_description').modal('show');
        });

        // Existing View Note button
        $(document).on('click', '.view-note-btn', function () {
            $('#note_subject').text($(this).data('subject'));
            $('#note_status').text($(this).data('status'));
            $('#note_text').text($(this).data('note') || 'No note available.');
            $('#view_note').modal('show');
        });

        // Add Remark
        $(document).on('click', '.add-remark-btn', function () {
            $('#remark_request_id').val($(this).data('id'));
            $('#remark_subject').val($(this).data('subject'));
            $('#remark_text').val('');
            $('#add_remark').modal('show');
        });

        // Delete confirmation
        $(document).on('click', '.delete-request-btn', function () {
            $('#delete_request_id').val($(this).data('id'));
            $('#delete_request_subject').text($(this).data('subject'));
            $('#delete_request_modal').modal('show');
        });

    });
</script>

<script src="templates/backend/employee/procurement_request.js"></script>




{% endblock %}